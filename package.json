{
  "name": "dsh-tui-nano",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "bin": {
    "nano": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && vitest run --config tests/feature/vitest.config.ts",
    "test:watch": "vitest",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "lint": "biome check src tests",
    "keymap:docs": "node scripts/keymap-docs.mjs",
    "prepack": "npm run build && node scripts/keymap-docs.mjs --check && node scripts/prepack-check.mjs",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "marked": "^15.0.12",
    "prismjs": "^1.30.0",
    "react": "^19.1.1",
    "react-reconciler": "^0.33.0",
    "string-width": "^7.2.0",
    "yaml": "^2.9.1",
    "yoga-layout": "^3.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^24.3.0",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.1.12",
    "@types/react-reconciler": "^0.32.1",
    "npm-packlist": "^11.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-group": "1.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/cordis-plugin-timer": "1.1.7"
  }
}
